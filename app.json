{
  "expo": {
    "name": "HealthCal",
    "slug": "healthcal",
    "version": "1.0.0",
    "runtimeVersion": "3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "healthcal",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C43670",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.healthcal.mobile",
      "runtimeVersion": "4",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_HEART_RATE"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4EEE5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#121110",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "HealthCal uses the camera to scan barcodes and photograph meals."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HealthCal reads the photos you pick to estimate the nutrition of a meal.",
          "cameraPermission": "HealthCal uses the camera to photograph meals."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C43670"
        }
      ],
      "expo-sharing",
      "expo-localization",
      "expo-font",
      [
        "./plugins/withStorageSize",
        {
          "megabytes": 64
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "HealthCal reads the workouts, heart rate during workouts, steps, sleep, weight, body fat and energy burned you choose from Apple Health to fill your training week, sleep log and weigh-ins. It never writes to Apple Health and never sends this data to the AI functions.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/bricolage-grotesque/700Bold/BricolageGrotesque_700Bold.ttf",
            "./node_modules/@expo-google-fonts/hanken-grotesk/500Medium/HankenGrotesk_500Medium.ttf",
            "./node_modules/@expo-google-fonts/hanken-grotesk/700Bold/HankenGrotesk_700Bold.ttf"
          ],
          "widgets": [
            {
              "name": "TodayWidget",
              "label": "HealthCal today",
              "description": "Calories left and water, with a one-tap glass",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen|not_keyguard",
              "previewImage": "./assets/widget-preview/today.png",
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.healthcal.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "HealthCal uses the camera to scan barcodes and photograph meals for nutrition estimates.",
        "NSPhotoLibraryUsageDescription": "HealthCal reads the photos you pick to estimate the nutrition of a meal."
      }
    },
    "extra": {
      "eas": {
        "projectId": "a39efd68-9624-4740-8749-999371098d89"
      }
    },
    "owner": "pelegy",
    "updates": {
      "url": "https://u.expo.dev/a39efd68-9624-4740-8749-999371098d89",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
