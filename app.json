{
  "expo": {
    "name": "HealthCal",
    "slug": "healthcal",
    "version": "1.0.0",
    "runtimeVersion": "1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "healthcal",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C43670",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.healthcal.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_STEPS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4EEE5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#121110",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "HealthCal uses the camera to scan barcodes and photograph meals."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HealthCal reads the photos you pick to estimate the nutrition of a meal.",
          "cameraPermission": "HealthCal uses the camera to photograph meals."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C43670"
        }
      ],
      "expo-sharing",
      "expo-localization",
      "expo-font",
      [
        "./plugins/withStorageSize",
        {
          "megabytes": 64
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "HealthCal reads the workouts and steps you choose from Apple Health to fill your training week. It never writes to Apple Health and never sends this data to the AI functions.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.healthcal.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "HealthCal uses the camera to scan barcodes and photograph meals for nutrition estimates.",
        "NSPhotoLibraryUsageDescription": "HealthCal reads the photos you pick to estimate the nutrition of a meal."
      }
    },
    "extra": {
      "eas": {
        "projectId": "a39efd68-9624-4740-8749-999371098d89"
      }
    },
    "owner": "pelegy",
    "updates": {
      "url": "https://u.expo.dev/a39efd68-9624-4740-8749-999371098d89",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
